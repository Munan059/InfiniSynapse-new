# 复制本文件为 .env 后，填入真实内容

# ===== 「使用 InfiniSynapse 登录」(Partner SSO) 必填 =====
# 获取方式：登录 InfiniSynapse → 左下角齿轮 → 第三方接入 → 创建接入应用
# 应用名填「新领域教学助手」，回调域名白名单填 localhost（本地）和你的部署域名（如 xxx.vercel.app）
# 创建后弹窗会显示 clientId / clientSecret（只显示一次，存好）
INFINI_CLIENT_ID=你的clientId
INFINI_CLIENT_SECRET=你的clientSecret

# 用于加密登录态 cookie 的服务端密钥：随便写一长串随机字符（部署前务必改成你自己的，别用示例值）
SESSION_SECRET=请改成你自己的随机长字符串_例如_4f2a9c1e8b7d3

# 你这个应用自己的对外地址：本地用 http://localhost:3000，部署后改成 https://你的域名
PUBLIC_ORIGIN=http://localhost:3000

# 可选：部署者自己自测用的兜底 Key（不填也行，访客走登录）
# INFINISYNAPSE_API_KEY=sk-xxxx

PORT=3000
